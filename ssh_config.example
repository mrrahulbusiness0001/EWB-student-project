# Replace BASTION_PUBLIC_IP and /path/to/your-key.pem.
# Save as ~/.ssh/config and restrict permissions on the key file (chmod 400).
Host ewb-bastion
    HostName BASTION_PUBLIC_IP
    User ec2-user
    IdentityFile ~/.ssh/your-key.pem
    IdentitiesOnly yes

Host ewb-app-a
    HostName 10.10.2.10
    User ec2-user
    IdentityFile ~/.ssh/your-key.pem
    IdentitiesOnly yes
    ProxyJump ewb-bastion

Host ewb-app-b
    HostName 10.20.1.10
    User ec2-user
    IdentityFile ~/.ssh/your-key.pem
    IdentitiesOnly yes
    ProxyJump ewb-bastion
